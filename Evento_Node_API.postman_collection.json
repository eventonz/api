{
  "info": {
    "_postman_id": "evento-node-api-local",
    "name": "Evento Node API (Local)",
    "description": "Local Postman collection. Authed routes use the {{bearer}} variable; public timer/webhook routes override auth to noauth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{bearer}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl",        "value": "http://localhost:3000" },
    { "key": "bearer",         "value": "e1ac3e527ea040be8704d711717c15a75658db82323ab6fdf7963179cd8e3d0b" },
    { "key": "appid",          "value": "44" },
    { "key": "race_id",        "value": "833" },
    { "key": "rr_eventid",     "value": "396995" },
    { "key": "ss_raceid",      "value": "19328" },
    { "key": "racetec_apikey", "value": "7B206D3B-1F0D-473A-BC4B-0AFD2BEEEACB" },
    { "key": "athlete_id",     "value": "1001" },
    { "key": "raceno",         "value": "999" },
    { "key": "player_id",      "value": "test-onesignal-player-id" },
    { "key": "device_id",      "value": "test-device-id-001" },
    { "key": "page_id",        "value": "1" },
    { "key": "map_uuid",       "value": "REPLACE_WITH_REAL_MAP_UUID" },
    { "key": "map_token",      "value": "REPLACE_WITH_REAL_MAP_TOKEN" },
    { "key": "assistant_uuid", "value": "REPLACE_WITH_REAL_ASSISTANT_UUID" },
    { "key": "edition",        "value": "2026" },
    { "key": "rr_event_id",    "value": "REPLACE_WITH_TIMER_EVENT_ID" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        { "name": "GET /",       "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/",       "host": ["{{baseUrl}}"], "path": [""] } } },
        { "name": "GET /health", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } } },
        { "name": "GET /debug",  "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/debug",  "host": ["{{baseUrl}}"], "path": ["debug"] } } }
      ]
    },
    {
      "name": "Timer Push (public, enqueues)",
      "item": [
        {
          "name": "POST /v1/tracks/race/:race_id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"athlete_id\": \"{{athlete_id}}\",\n  \"race_no\": \"{{raceno}}\",\n  \"contest_id\": 1,\n  \"split_id\": 1,\n  \"tod\": \"08:15:00\",\n  \"race_time\": \"00:30:00\",\n  \"name\": \"Alice Tuson\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/tracks/race/{{race_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "tracks", "race", "{{race_id}}"] }
          }
        },
        {
          "name": "POST /v1/tracks/sportsplits/:ss_raceid",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"athlete_id\": \"123\",\n  \"race_no\": \"123\",\n  \"contest_id\": 1,\n  \"split_id\": 1,\n  \"tod\": \"08:15:00\",\n  \"race_time\": \"00:30:00\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/tracks/sportsplits/{{ss_raceid}}", "host": ["{{baseUrl}}"], "path": ["v1", "tracks", "sportsplits", "{{ss_raceid}}"] }
          }
        },
        {
          "name": "POST /v1/tracks/racetec/:racetec_apikey",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "[\n  {\n    \"tod\": \"07:43:53\",\n    \"name\": \"Jules GREEN\",\n    \"race_no\": 136,\n    \"event_id\": 1,\n    \"split_id\": 2,\n    \"race_time\": \"00:13:54\",\n    \"split_speed\": \"\"\n  }\n]" },
            "url": { "raw": "{{baseUrl}}/v1/tracks/racetec/{{racetec_apikey}}", "host": ["{{baseUrl}}"], "path": ["v1", "tracks", "racetec", "{{racetec_apikey}}"] }
          }
        },
        {
          "name": "POST /v1/tracks/raceresult/:rr_eventid",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"evento_created\": true,\n  \"bib\": \"123\",\n  \"athlete_id\": \"123\",\n  \"firstname\": \"Jane\",\n  \"lastname\": \"Doe\",\n  \"contestid\": 1,\n  \"rr_splitid\": 5,\n  \"race_time\": \"00:30:00\",\n  \"tod\": \"08:15:00\",\n  \"start\": 0,\n  \"finish\": 0,\n  \"split_speed\": \"12.5\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/tracks/raceresult/{{rr_eventid}}", "host": ["{{baseUrl}}"], "path": ["v1", "tracks", "raceresult", "{{rr_eventid}}"] }
          }
        },
        {
          "name": "POST /v1/rr_webhook/:race_id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"Values\": {\n    \"ID\": \"99999\",\n    \"BIB\": \"777\",\n    \"FIRSTNAME\": \"Test\",\n    \"LASTNAME\": \"Webhook\",\n    \"CONTEST.ID\": 1,\n    \"CONTEST.NAME\": \"Marathon\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/v1/rr_webhook/{{race_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "rr_webhook", "{{race_id}}"] }
          }
        },
        {
          "name": "POST /v1/adverts/:uuid (impression)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"impression\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/adverts/REPLACE_WITH_REAL_ADVERT_UUID", "host": ["{{baseUrl}}"], "path": ["v1", "adverts", "REPLACE_WITH_REAL_ADVERT_UUID"] }
          }
        },
        {
          "name": "POST /v1/adverts/:uuid (click)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"click\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/adverts/REPLACE_WITH_REAL_ADVERT_UUID", "host": ["{{baseUrl}}"], "path": ["v1", "adverts", "REPLACE_WITH_REAL_ADVERT_UUID"] }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        { "name": "GET /v1/events/:appid",          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/events/{{appid}}",          "host": ["{{baseUrl}}"], "path": ["v1", "events", "{{appid}}"] } } },
        { "name": "GET /v1/events/:appid/upcoming", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/events/{{appid}}/upcoming", "host": ["{{baseUrl}}"], "path": ["v1", "events", "{{appid}}", "upcoming"] } } },
        { "name": "GET /v1/events/:appid/past",     "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/events/{{appid}}/past",     "host": ["{{baseUrl}}"], "path": ["v1", "events", "{{appid}}", "past"] } } }
      ]
    },
    {
      "name": "Config",
      "item": [
        { "name": "GET /v1/config/:race_id",       "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/config/{{race_id}}",       "host": ["{{baseUrl}}"], "path": ["v1", "config", "{{race_id}}"] } } },
        { "name": "GET /v1/config/:race_id/check", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/config/{{race_id}}/check", "host": ["{{baseUrl}}"], "path": ["v1", "config", "{{race_id}}", "check"] } } }
      ]
    },
    {
      "name": "Athletes",
      "item": [
        {
          "name": "POST /v1/athletes/:race_id (search/paginate, empty)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pageNumber\": 1,\n  \"searchstring\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/athletes/{{race_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "athletes", "{{race_id}}"] }
          }
        },
        {
          "name": "POST /v1/athletes/:race_id (search by name)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pageNumber\": 1,\n  \"searchstring\": \"alice\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/athletes/{{race_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "athletes", "{{race_id}}"] }
          }
        },
        {
          "name": "PATCH /v1/athletes/:race_id (validate followed athletes)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"edition\": \"{{edition}}\",\n  \"athletes\": [\"1001\", \"1002\", \"1003\"]\n}" },
            "url": { "raw": "{{baseUrl}}/v1/athletes/{{race_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "athletes", "{{race_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "GET /v1/notifications/:race_id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/notifications/{{race_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "notifications", "{{race_id}}"] } } }
      ]
    },
    {
      "name": "Follow",
      "item": [
        {
          "name": "POST /v1/follow",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"event_id\": {{race_id}},\n  \"player_id\": \"{{player_id}}\",\n  \"number\": \"{{raceno}}\",\n  \"contest\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/v1/follow", "host": ["{{baseUrl}}"], "path": ["v1", "follow"] }
          }
        },
        {
          "name": "DELETE /v1/follow",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"event_id\": {{race_id}},\n  \"player_id\": \"{{player_id}}\",\n  \"number\": \"{{raceno}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/follow", "host": ["{{baseUrl}}"], "path": ["v1", "follow"] }
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "POST /v1/settings",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"race_id\": {{race_id}},\n  \"player_id\": \"{{player_id}}\",\n  \"notifications\": {\n    \"event\": true,\n    \"athlete\": true\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/v1/settings", "host": ["{{baseUrl}}"], "path": ["v1", "settings"] }
          }
        },
        { "name": "GET /v1/settings/:player_id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/settings/{{player_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "settings", "{{player_id}}"] } } }
      ]
    },
    {
      "name": "Assistant",
      "item": [
        { "name": "GET /v1/assistant/:uuid (config)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/assistant/{{assistant_uuid}}", "host": ["{{baseUrl}}"], "path": ["v1", "assistant", "{{assistant_uuid}}"] } } },
        {
          "name": "POST /v1/assistant/:uuid (chat)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Where is the bag drop?\",\n  \"messages\": [],\n  \"source\": \"postman\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/assistant/{{assistant_uuid}}", "host": ["{{baseUrl}}"], "path": ["v1", "assistant", "{{assistant_uuid}}"] }
          }
        },
        {
          "name": "POST /v1/assistant/report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"race_id\": {{race_id}},\n  \"content\": \"User reported the AI gave incorrect aid station info\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/assistant/report", "host": ["{{baseUrl}}"], "path": ["v1", "assistant", "report"] }
          }
        }
      ]
    },
    {
      "name": "App",
      "item": [
        {
          "name": "POST /v1/app_install",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"app_id\": {{appid}},\n  \"platform\": \"ios\",\n  \"install_version\": \"1.0.0\",\n  \"device_id\": \"{{device_id}}\",\n  \"installed_at\": \"2026-05-04T20:00:00Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/app_install", "host": ["{{baseUrl}}"], "path": ["v1", "app_install"] }
          }
        },
        {
          "name": "GET /v1/app_version/:app_id  (cached 30min, X-Cache header)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/app_version/{{appid}}", "host": ["{{baseUrl}}"], "path": ["v1", "app_version", "{{appid}}"] } }
        },
        {
          "name": "POST /v1/app_version/:app_id  (busts cache)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"version\": \"1.0.1\",\n  \"android_version\": \"1.0.1\",\n  \"ios_store_url\": \"https://apps.apple.com/...\",\n  \"android_store_url\": \"https://play.google.com/...\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/app_version/{{appid}}", "host": ["{{baseUrl}}"], "path": ["v1", "app_version", "{{appid}}"] }
          }
        }
      ]
    },
    {
      "name": "Timer Events (admin)",
      "item": [
        {
          "name": "POST /v1/timer/events  (create)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"mode\": \"results\",\n  \"name\": \"Test Event\",\n  \"appid\": {{appid}}\n}" },
            "url": { "raw": "{{baseUrl}}/v1/timer/events", "host": ["{{baseUrl}}"], "path": ["v1", "timer", "events"] }
          }
        },
        {
          "name": "PATCH /v1/timer/events/:rr_event_id",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated\"\n}" },
            "url": { "raw": "{{baseUrl}}/v1/timer/events/{{rr_event_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "timer", "events", "{{rr_event_id}}"] }
          }
        },
        {
          "name": "DELETE /v1/timer/events/:rr_event_id",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/v1/timer/events/{{rr_event_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "timer", "events", "{{rr_event_id}}"] }
          }
        }
      ]
    },
    {
      "name": "CMS Pages",
      "item": [
        { "name": "GET /v1/redirect/:page_id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/redirect/{{page_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "redirect", "{{page_id}}"] } } },
        { "name": "GET /v1/schedule/:page_id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/schedule/{{page_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "schedule", "{{page_id}}"] } } },
        { "name": "GET /v1/list/:page_id",     "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/list/{{page_id}}",     "host": ["{{baseUrl}}"], "path": ["v1", "list", "{{page_id}}"] } } },
        { "name": "GET /v1/carousel/:page_id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/carousel/{{page_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "carousel", "{{page_id}}"] } } }
      ]
    },
    {
      "name": "Maps",
      "item": [
        {
          "name": "GET /v1/maps/:uuid",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/maps/{{map_uuid}}?elevation=true", "host": ["{{baseUrl}}"], "path": ["v1", "maps", "{{map_uuid}}"], "query": [{ "key": "elevation", "value": "true" }] } }
        },
        { "name": "GET /v1/maps/race/:race_id", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/maps/race/{{race_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "maps", "race", "{{race_id}}"] } } },
        { "name": "GET /v1/maps/:uuid/validate/:token", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/v1/maps/{{map_uuid}}/validate/{{map_token}}", "host": ["{{baseUrl}}"], "path": ["v1", "maps", "{{map_uuid}}", "validate", "{{map_token}}"] } } },
        {
          "name": "POST /v1/maps/:uuid (upload — multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [
              { "key": "file", "type": "file", "src": [] },
              { "key": "title", "value": "My Map", "type": "text" }
            ]},
            "url": { "raw": "{{baseUrl}}/v1/maps/{{map_uuid}}", "host": ["{{baseUrl}}"], "path": ["v1", "maps", "{{map_uuid}}"] }
          }
        }
      ]
    }
  ]
}
