PORT=3000
NODE_ENV=development

# PostgreSQL
PG_HOST=db-postgresql-3-may-2026-do-user-3724083-0.j.db.ondigitalocean.com
PG_PORT=25061
PG_DATABASE=evento_pool
PG_USER=doadmin
PG_PASSWORD=
PG_SSL=true

# Redis / Valkey
REDIS_HOST=db-valkey-syd1-09683-do-user-3724083-0.j.db.ondigitalocean.com
REDIS_PORT=25061
REDIS_PASSWORD=
REDIS_TLS=true

# JWT
JWT_SECRET=

# DigitalOcean Spaces (S3-compatible)
DO_SPACES_KEY=
DO_SPACES_SECRET=

# RaceResult API key encryption (must match ColdFusion value)
RR_ENCRYPTION_KEY=evento_rr_2024

# aievento DB (Assistant + pgvector). Defaults to PG_* host/user/password,
# with port 25060 and database 'aievento'. Override only if needed.
# AIEVENTO_HOST=
# AIEVENTO_PORT=25060
# AIEVENTO_DATABASE=aievento
# AIEVENTO_USER=
# AIEVENTO_PASSWORD=
# AIEVENTO_SSL=true

# Assistant LLM
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Better Stack logging (leave blank to log to stdout only)
LOGTAIL_SOURCE_TOKEN=
LOGTAIL_INGESTING_HOST=
# LOG_LEVEL=info  # optional override; defaults: warn in prod, info elsewhere
